---
import '../styles/global.css';
import { SITE_URL, DEFAULT_OG_IMAGE, SITE_INFO } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  canonical?: string;
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
  articleTags?: string[];
  includeFaqSchema?: boolean;
  robots?: string;
  pageVariant?: string;
  articleSlug?: string;
  articleCluster?: string;
}

const {
  title = 'Dra. Marcela Santana — Santana Consultoria de Trânsito | Suspensão de CNH e Recurso de Multas',
  description = 'Consultoria especializada em Direito de Trânsito com a Dra. Marcela Santana. Defesa técnica contra Suspensão de CNH, Cassação e Recursos de Multas. Atendimento humanizado em todo o Brasil.',
  type = 'website',
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  publishedTime,
  modifiedTime,
  articleAuthor,
  articleTags = [],
  includeFaqSchema = true,
  robots = 'index, follow',
  pageVariant,
  articleSlug,
  articleCluster,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site || SITE_URL).toString();

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Posso continuar dirigindo enquanto apresento recurso contra a suspensão da CNH?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sim. O recurso administrativo protocolado tempestivamente assegura o efeito suspensivo do processo de suspensão da CNH, garantindo que você continue dirigindo regularmente até o julgamento final pelas instâncias cabíveis.',
      },
    },
    {
      '@type': 'Question',
      name: 'Qual o prazo para recorrer da notificação do DETRAN?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O prazo legal para apresentação da defesa previa ou recurso costuma ser de 15 a 30 dias contados a partir da notificação oficial. É fundamental realizar a análise técnica o quanto antes.',
      },
    },
    {
      '@type': 'Question',
      name: 'Vale a pena recorrer de multa de trânsito ou suspensão por pontos?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Com certeza. Diversos processos administrativos contêm falhas formais, prazos prescritos ou falta de aferição regular dos equipamentos. Uma defesa técnica fundamentada no CTB verifica se a penalidade respeitou o devido processo legal.',
      },
    },
  ],
};

const attorneySchema = {
  '@context': 'https://schema.org',
  '@type': 'Attorney',
  name: 'Dra. Marcela Santana — Santana Consultoria de Trânsito',
  image: `${SITE_URL}/Santana-logo-dark-2.svg`,
  url: SITE_URL,
  telephone: '+5534991692737',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE_INFO.address.street,
    addressLocality: SITE_INFO.address.city,
    addressRegion: SITE_INFO.address.region,
    postalCode: SITE_INFO.address.postalCode,
    addressCountry: SITE_INFO.address.country,
  },
  knowsAbout: [
    'Direito de Trânsito',
    'Suspensão de CNH',
    'Cassação de CNH',
    'Recurso de Multas de Trânsito',
    'Defesa de Lei Seca',
  ],
};
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-TVP2DGX9');</script>
  <!-- End Google Tag Manager -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/Icone2.png" />
  <link rel="canonical" href={canonicalURL} />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  {type === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )}
  {type === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )}
  {type === 'article' && articleAuthor && (
    <meta property="article:author" content={articleAuthor} />
  )}
  {type === 'article' && articleTags.map((tag) => (
    <meta property="article:tag" content={tag} />
  ))}

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImage} />

  <!-- Schema.org Rich Snippets (SEO) -->
  {includeFaqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(attorneySchema)} />
  <slot name="head" />
</head>
<body
  data-page-variant={pageVariant}
  data-article-slug={articleSlug}
  data-article-cluster={articleCluster}
>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TVP2DGX9"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <slot />
  <!-- Medição S2 (dataLayer -> GTM -> GA4) -->
  <script is:inline src="/s2-tracking.js" defer></script>
</body>
</html>
