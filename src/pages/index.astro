---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Servicos from '../components/Servicos.astro';
import Diferenciais from '../components/Diferenciais.astro';
import SobreDraMarcela from '../components/SobreDraMarcela.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Faq from '../components/Faq.astro';
import CtaWhatsapp from '../components/CtaWhatsapp.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Dra. Marcela Santana — Advocacia Especializada em Direito de Trânsito | Suspensão de CNH e Recurso de Multas"
  description="Assessoria jurídica especializada em Direito de Trânsito com a Dra. Marcela Santana. Defesa técnica contra Suspensão de CNH, Cassação e Recurso de Multas graves perante o DETRAN, JARI e CETRAN."
>
  <Header />
  <main>
    <Hero />
    <Servicos />
    <Diferenciais />
    <SobreDraMarcela />
    <ComoFunciona />
    <Faq />
    <CtaWhatsapp />
  </main>
  <Footer />
</Layout>
